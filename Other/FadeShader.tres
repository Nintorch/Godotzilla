code = "shader_type canvas_item;
render_mode blend_mix;

uniform bool WhiteFade;
uniform float Progress : hint_range(0.0, 1.0) = 0.0;



void fragment() {
// BooleanParameter:15
	bool n_out15p0 = WhiteFade;


// Input:13
	vec4 n_out13p0 = COLOR;


// FloatParameter:7
	float n_out7p0 = Progress;


// VectorOp:17
	vec3 n_out17p0 = vec3(n_out13p0.xyz) + vec3(n_out7p0);


// VectorOp:14
	vec3 n_out14p0 = vec3(n_out13p0.xyz) - vec3(n_out7p0);


	vec3 n_out16p0;
// If:16
	float n_in16p1 = 1.00000;
	float n_in16p2 = 0.00001;
	vec3 n_in16p4 = vec3(0.00000, 0.00000, 0.00000);
	if(abs((n_out15p0 ? 1.0 : 0.0) - n_in16p1) < n_in16p2)
	{
		n_out16p0 = n_out17p0;
	}
	else if((n_out15p0 ? 1.0 : 0.0) < n_in16p1)
	{
		n_out16p0 = n_out14p0;
	}
	else
	{
		n_out16p0 = n_in16p4;
	}


// Output:0
	COLOR.rgb = n_out16p0;


}
